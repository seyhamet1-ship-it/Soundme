{
  "root": true,
  "env": { "browser": true, "es2021": true, "node": true },
  "extends": ["eslint:recommended"],
  "rules": { "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^(React|App)$" }] },
  "parserOptions": { "ecmaVersion": "latest", "sourceType": "module", "ecmaFeatures": { "jsx": true } },
  "globals": { "describe": "readonly", "it": "readonly", "expect": "readonly", "vi": "readonly", "afterEach": "readonly" }
}
