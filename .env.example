# ─────────────────────────────────────────────────────────────────────────────
# Soundme — .env.example
# Copy to .env and fill in your values before running.
# ─────────────────────────────────────────────────────────────────────────────

# ── Access control (REQUIRED) ─────────────────────────────────────────────────
# Comma-separated list of access tokens issued to testers.
# Each token is independent: Token A cannot read Token B's jobs.
# To rotate: remove old token and restart the service.
ACCESS_TOKENS=change-me-token-1,change-me-token-2

# ── Domain (Docker / Mode B only) ────────────────────────────────────────────
# Caddy uses this for automatic HTTPS via Let's Encrypt.
# Leave blank for local-only or tunnel mode.
DOMAIN=soundme.example.com

# ── Rate limits & abuse controls ──────────────────────────────────────────────
RATE_LIMIT_RPM=120          # requests per minute per token
MAX_QUEUE_CAP=5             # max queued jobs before 429
DAILY_QUOTA_MINUTES=60      # max video-minutes per token per day
CLEANUP_TTL_HOURS=24        # delete uploads/outputs after N hours
MAX_CONCURRENT_JOBS=1       # parallel processing workers

# ── Upload limits ─────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=2048
MAX_UPLOAD_MB=2048
MAX_DURATION_MIN=240  # max video minutes (0 = unlimited)

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Restrict to your public URL in production.
# Example: https://soundme.example.com,https://abc123.trycloudflare.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── TTS provider order ────────────────────────────────────────────────────────
# Comma-separated: azure,edge,mms
# Mode A (Windows/tunnel):  TTS_PROVIDER_ORDER=edge,mms
# Mode B (VPS/Docker):      TTS_PROVIDER_ORDER=azure,mms
TTS_PROVIDER_ORDER=edge,mms

# ── Azure Speech (primary TTS for VPS — datacenter IPs block Edge TTS) ───────
# Get from Azure portal > Speech resource > Keys and Endpoint
# Leave blank to skip Azure and fall back to Edge TTS or MMS.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Azure free neural tier allows 0.5M chars/month; cap at 450K for safety.
# Increase if you upgrade to a paid tier.
AZURE_MONTHLY_CHAR_CAP=450000

# ── ASR ──────────────────────────────────────────────────────────────────────
ASR_MODEL=small             # small | medium | large-v3
ASR_DEVICE=cpu              # cpu | cuda

# ── Translation ───────────────────────────────────────────────────────────────
TRANSLATION_PROVIDER=nllb   # nllb | demo

# ── Data paths ───────────────────────────────────────────────────────────────
# For best performance, set to a LOCAL SSD path, not a cloud-synced folder.
# UPLOAD_DIR=/data/uploads
# JOB_DB=/data/jobs.sqlite3

# ── Model warm-up at startup ──────────────────────────────────────────────────
# Set to 0 to skip (useful for development). When 1, /api/health reports
# models_ready:true after load completes (~10 s if baked into image, else ~165 s).
WARM_MODELS_AT_STARTUP=1

# -- Phase 10: Sessions & Google OAuth -----------------------------------------
# REQUIRED: Random secret for signing session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If not set, a random key is generated at startup (sessions lost on restart).
SECRET_KEY=change-me-generate-with-python-secrets-token-hex-32

# Google OAuth 2.0 (optional  leave blank to disable Google login)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://yourdomain.com/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://soundme.example.com/auth/callback

# Session cookie lifetime (default 24 h  matches TTL cleanup)
SESSION_TTL_HOURS=24

# Set to 1 in production (HTTPS-only)  leave 0 for local/tunnel dev
SESSION_HTTPS_ONLY=0
