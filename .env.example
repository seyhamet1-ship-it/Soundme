# Soundme Environment Configuration
# Copy to .env and adjust as needed.

# Upload and duration limits
MAX_UPLOAD_MB=500
MAX_DURATION_MIN=30

# ASR (Speech Recognition)
ASR_MODEL=small
ASR_DEVICE=cpu

# Translation
TRANSLATION_PROVIDER=local
NLLB_MODEL=facebook/nllb-200-distilled-600M

# TTS (Text-to-Speech) - auto tries Edge > Azure > MMS
TTS_PROVIDER=auto
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=

# Workers
MAX_WORKERS=2
